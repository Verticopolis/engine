{
  // The package's TypeScript layer: model/, catalog/, binding/, port/, host/
  // and testing/, checked against the fresh wasm-bindgen output. The
  // @verticopolis/engine/* paths are the package's own subpaths (a
  // self-reference): in the repository they point at the wasm/ build, and
  // in the shipped package the exports map resolves them.
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "skipLibCheck": true,
    "paths": {
      "@verticopolis/engine/tooling/node/verticopolis_engine": ["../../wasm/pkg/verticopolis_engine.d.ts"],
      "@verticopolis/engine/events/gameplayEvents": ["../../wasm/pkg-events/gameplayEvents.d.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
