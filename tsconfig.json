{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["tools/**/*.ts", "scripts/**/*.ts", "scripts/**/*.mts"],
  "exclude": ["scripts/package-consumer/types.ts"]
}
