{
  "name": "verticopolis-engine-repo",
  "private": true,
  "description": "The repository's build and check tooling. The published npm package is defined by packages/verticopolis-engine/package.json.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "wasm:build": "node scripts/wasm-build.ts",
    "pack": "sh scripts/pack-engine.sh",
    "test": "vitest run --dir tools && vitest run --dir scripts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "layer:typecheck": "tsc -p packages/verticopolis-engine/tsconfig.json",
    "layer:test": "vitest run --dir packages/verticopolis-engine/src",
    "glue:test": "vitest run --dir packages/verticopolis-engine/glue --testTimeout 120000 --hookTimeout 120000",
    "layer:fixtures": "node scripts/layer-fixtures.ts",
    "layer:build": "node scripts/layer-build.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "uri-js": "npm:fast-uri@^3.1.9"
  }
}
